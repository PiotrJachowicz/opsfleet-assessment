HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@127.0.0.1:5433/chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_INCLUDE_THOUGHTS=true
GEMINI_THINKING_LEVEL=medium
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_INITIAL_DELAY=2.0
GEMINI_RETRY_MAX_DELAY=60.0
GEMINI_RETRY_BACKOFF=2.0
GEMINI_TIMEOUT_SECONDS=120
GCP_PROJECT=ops-test-piotr
GOOGLE_APPLICATION_CREDENTIALS=
BQ_MAX_ROWS=100
BQ_MAX_BYTES_BILLED=1000000000
BQ_TIMEOUT_SECONDS=60
BQ_EMPTY_REPAIR_ATTEMPTS=2
AGENT_RECURSION_LIMIT=25
JWT_SECRET=dev-jwt-secret-change-me
REPORTS_DIR=output/reports
LOGS_DIR=output/logs
LOG_FILE_NAME=chatbot.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opsfleet-chatbot
LANGSMITH_ENDPOINT=
LANGSMITH_DATASET=opsfleet-retail-agent-eval
